# 6. 视频主题相关性判断
# ==================================================

def check_relevance(title, description):
    """
    根据视频标题和简介判断是否与岭南饮食相关。

    返回：
    是否相关、评分、匹配依据
    """

    title = clean_text(title).lower()
    description = clean_text(description).lower()

    score = 0
    matched_terms = []

    # 核心主题词
    for term in CORE_TERMS:

        term_lower = term.lower()

        if term_lower in title:

            score += 5

            matched_terms.append(
                f"标题：{term}"
            )

        elif term_lower in description:

            score += 3

            matched_terms.append(
                f"简介：{term}"
            )

    # 具体菜品
    for term in DISH_TERMS:

        term_lower = term.lower()

        if term_lower in title:

            score += 4

            matched_terms.append(
                f"标题：{term}"
            )

        elif term_lower in description:

            score += 2

            matched_terms.append(
                f"简介：{term}"
            )

    # 是否存在饮食上下文
    context_count = 0

    for term in FOOD_CONTEXT_TERMS:

        if (
            term.lower() in title
            or term.lower() in description
        ):

            context_count += 1

    # 核心主题词
    has_core = any(
        term.lower() in title
        or term.lower() in description
        for term in CORE_TERMS
    )

    # 具体菜品
    has_dish = any(
        term.lower() in title
        or term.lower() in description
        for term in DISH_TERMS
    )

    # 没有核心主题或具体菜品，直接排除
    if not (has_core or has_dish):

        return False, score, ""

    # 仅出现菜品名称时，还需要饮食语境
    if not has_core and context_count == 0:

        return False, score, ""

    is_relevant = score >= 3

    matched_terms = list(
        dict.fromkeys(matched_terms)
    )

    return (
        is_relevant,
        score,
        "；".join(matched_terms)
    )


# ==================================================
# 7. 单个关键词搜索与自动分页
# ==================================================

def search_videos(
    keyword,
    target_count,
    mixin_key
):
    """
    只搜索用户输入的原始关键词。

    target_count是有效视频目标数量。
    """

    print(f"\n正在搜索：{keyword}")

    videos = []

    collected_ids = set()

    page = 1

    no_new_pages = 0

    stopped_by_error = False

    while (
        len(videos) < target_count
        and page <= MAX_PAGES
    ):

        params = {
            "search_type": "video",
            "keyword": keyword,
            "page": page,
            "page_size": PAGE_SIZE,
            "order": "totalrank"
        }

        signed_params = sign_params(
            params,
            mixin_key
        )

        try:

            response = session.get(
                BASE_URL + "/x/web-interface/wbi/search/type",
                params=signed_params,
                headers=headers,
                timeout=30
            )

            response.raise_for_status()

            result = response.json()

            if result.get("code") != 0:

                print(
                    f"搜索接口异常："
                    f"错误代码 {result.get('code')}，"
                    f"原因：{result.get('message')}"
                )

                stopped_by_error = True
                break

            data = result.get("data", {})

            items = data.get("result", [])

            # 没有搜索结果
            if not items:

                print("没有更多搜索结果。")
                break

            new_count = 0

            for item in items:

                bvid = item.get("bvid", "")

                # 过滤无效BV号
                if (
                    not bvid
                    or not bvid.startswith("BV")
                ):
                    continue

                # 同一关键词内部去重
                if bvid in collected_ids:
                    continue

                title = clean_text(
                    item.get("title", "")
                )

                description = clean_text(
                    item.get(
                        "description",
                        item.get("desc", "")
                    )
                )

                # 判断主题相关性
                is_relevant, score, reason = (
                    check_relevance(
                        title,
                        description
                    )
                )

                # 排除不相关视频
                if not is_relevant:
                    continue

                collected_ids.add(bvid)

                thumbnail = item.get("pic", "")

                if thumbnail.startswith("//"):

                    thumbnail = (
                        "https:" + thumbnail
                    )

                video = {

                    "video_id": bvid,

                    "视频标题": title,

                    "UP主名称": item.get(
                        "author", ""
                    ),

                    "发布时间": format_publish_time(
                        item.get("pubdate", 0)
                    ),

                    "视频时长": format_duration(
                        item.get("duration", "")
                    ),

                    "视频简介": description,

                    "视频分区": item.get(
                        "typename", ""
                    ),

                    "播放量": format_number(
                        item.get("play", 0)
                    ),

                    "点赞量": format_number(
                        item.get("like", 0)
                    ),

                    "收藏量": format_number(
                        item.get("favorites", 0)
                    ),

                    "检索关键词": keyword,

                    "相关性评分": score,

                    "相关性依据": reason,

                    "审核状态": (
                        "标题/简介初筛，待人工复核"
                    ),

                    "视频链接": (
                        f"https://www.bilibili.com/video/{bvid}"
                    ),

                    "视频封面": thumbnail
                }

                videos.append(video)

                new_count += 1

                # 达到目标数量
                if len(videos) >= target_count:
                    break

            # 达到目标数量，结束
            if len(videos) >= target_count:
                break

            # 判断本页是否有新的有效视频
            if new_count == 0:

                no_new_pages += 1

            else:

                no_new_pages = 0

            # 连续三页没有新结果，停止
            if no_new_pages >= MAX_NO_NEW_PAGES:

                print(
                    "连续多页没有新的有效视频，停止搜索。"
                )

                break

            page += 1

            # 控制请求频率
            time.sleep(
                random.uniform(1.5, 2.5)
            )

        except requests.RequestException as e:

            print(f"网络请求失败：{e}")

            stopped_by_error = True
            break

        except Exception as e:

            print(f"采集失败：{e}")

            stopped_by_error = True
            break

    if page > MAX_PAGES:

        print("已达到程序设置的分页安全上限。")

    print("\n" + "-" * 45)

    print(f"关键词：{keyword}")
    print(f"目标数量：{target_count}")
    print(f"实际有效数量：{len(videos)}")

    if len(videos) < target_count:

        print(
            f"未完成数量："
            f"{target_count - len(videos)}"
        )

        print(
            "提示：当前关键词可获取的有效搜索结果不足，"
            "或搜索过程受到接口限制。"
        )

    else:

        print("已达到目标数量！")

    return videos, stopped_by_error


# ==================================================
# 8. 多关键词采集与去重
# ==================================================

def crawl_all_videos(
    keywords,
    target_count,
    mixin_key
):
    """
    每个关键词独立采集目标数量。
    最终Excel按照BV号统一去重。
    """

    all_videos = {}

    keyword_results = []

    for keyword in keywords:

        print("\n" + "=" * 45)

        print(f"开始采集关键词：{keyword}")

        print(
            f"目标有效视频数量：{target_count}"
        )

        print("=" * 45)

        videos, stopped_by_error = search_videos(
            keyword,
            target_count,
            mixin_key
        )

        actual_count = len(videos)

        keyword_results.append({
            "关键词": keyword,
            "目标数量": target_count,
            "实际数量": actual_count,
            "缺少数量": max(
                0,
                target_count - actual_count
            ),
            "是否达到目标": (
                "是" if actual_count >= target_count
                else "否"
            ),
            "是否发生请求错误": (
                "是" if stopped_by_error else "否"
            )
        })

        for video in videos:

            video_id = video["video_id"]

            if video_id in all_videos:

                # 合并检索关键词
                old_keywords = (
                    all_videos[video_id]["检索关键词"]
                ).split("；")

                if keyword not in old_keywords:

                    all_videos[video_id]["检索关键词"] += (
                        f"；{keyword}"
                    )

            else:

                all_videos[video_id] = video

    return (
        list(all_videos.values()),
        keyword_results
    )


