# 4. 数据格式转换
# ==================================================

def clean_text(text):
    """清理HTML标签"""

    if not text:
        return ""

    text = html.unescape(str(text))

    text = re.sub(
        r"<[^>]+>",
        "",
        text
    )

    return text.strip()


def format_duration(duration):
    """统一视频时长格式为HH:MM:SS"""

    if not duration:
        return ""

    parts = str(duration).strip().split(":")

    try:

        if len(parts) == 2:

            minutes, seconds = map(int, parts)

            return (
                f"{minutes // 60:02d}:"
                f"{minutes % 60:02d}:"
                f"{seconds:02d}"
            )

        elif len(parts) == 3:

            hours, minutes, seconds = map(int, parts)

            return (
                f"{hours:02d}:"
                f"{minutes:02d}:"
                f"{seconds:02d}"
            )

    except ValueError:
        return ""

    return ""


def format_publish_time(timestamp):
    """将时间戳转换为北京时间"""

    if not timestamp:
        return ""

    try:

        dt = datetime.fromtimestamp(
            int(timestamp),
            tz=timezone.utc
        ).astimezone(BEIJING_TZ)

        return dt.strftime(
            "%Y-%m-%d %H:%M:%S"
        )

    except (ValueError, TypeError, OSError):
        return ""


def format_number(number):
    """整理数字字段"""

    if number is None:
        return 0

    try:
        return int(number)

    except (ValueError, TypeError):
        return 0


