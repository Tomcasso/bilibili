# 9. Excel导出
# ==================================================

def export_to_excel(
    videos,
    keyword_results
):
    """导出视频数据和关键词采集统计"""

    if not videos:

        print(
            "\n没有采集到符合主题的视频，"
            "暂不生成Excel。"
        )

        return

    timestamp = datetime.now().strftime(
        "%Y%m%d_%H%M%S"
    )

    file_path = (
        OUTPUT_DIR
        / f"Lingnan_Bilibili_{timestamp}.xlsx"
    )

    # 视频数据
    df = pd.DataFrame(videos)

    df = df.drop(
        columns=["video_id"]
    )

    columns = [
        "视频标题",
        "UP主名称",
        "发布时间",
        "视频时长",
        "视频简介",
        "视频分区",
        "播放量",
        "点赞量",
        "收藏量",
        "检索关键词",
        "相关性评分",
        "相关性依据",
        "审核状态",
        "视频链接",
        "视频封面"
    ]

    df = df[columns]

    # 关键词采集统计
    summary_df = pd.DataFrame(
        keyword_results
    )

    # 使用两个工作表
    with pd.ExcelWriter(
        file_path,
        engine="openpyxl"
    ) as writer:

        df.to_excel(
            writer,
            sheet_name="视频数据",
            index=False
        )

        summary_df.to_excel(
            writer,
            sheet_name="关键词采集统计",
            index=False
        )

    print("\n" + "=" * 50)

    print("B站岭南饮食主题视频采集完成！")

    print(
        f"最终不重复视频数量：{len(videos)} 条"
    )

    print("\n各关键词采集结果：")

    for item in keyword_results:

        print(
            f"{item['关键词']}："
            f"{item['实际数量']}/"
            f"{item['目标数量']} 条"
        )

        if item["缺少数量"] > 0:

            print(
                f"  尚缺：{item['缺少数量']} 条"
            )

    print(
        f"\nExcel文件已保存至：{file_path}"
    )

    print("=" * 50)


