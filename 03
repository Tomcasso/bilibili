# 10. 主程序
# ==================================================

def main():

    print("=" * 50)

    print(
        "       岭南非遗饮食 B站视频采集系统"
    )

    print("=" * 50)

    # 输入关键词
    print("\n默认关键词：")

    print("、".join(DEFAULT_KEYWORDS))

    user_input = input(
        "\n请输入搜索关键词"
        "（多个关键词用英文或中文逗号分隔，"
        "直接回车使用默认关键词）："
    ).strip()

    if user_input:

        keywords = [
            word.strip()
            for word in re.split(
                r"[,，]",
                user_input
            )
            if word.strip()
        ]

    else:

        keywords = DEFAULT_KEYWORDS.copy()

    # 删除重复输入的关键词
    keywords = list(
        dict.fromkeys(keywords)
    )

    if not keywords:

        print("没有输入有效关键词，程序结束。")
        return

    # 输入目标数量
    number_input = input(
        "\n请输入每个关键词目标有效视频数量"
        "（默认20，最高1000）："
    ).strip()

    try:

        target_count = (
            int(number_input)
            if number_input
            else 20
        )

        if not 1 <= target_count <= MAX_RESULTS_LIMIT:

            raise ValueError

    except ValueError:

        print("输入不合法，使用默认数量20。")

        target_count = 20

    print("\n采集配置：")

    print(f"搜索关键词数量：{len(keywords)}")

    print(
        f"每个关键词目标有效视频："
        f"{target_count} 条"
    )

    print(
        f"理论目标总数（去重前）："
        f"{len(keywords) * target_count} 条"
    )

    print("\n搜索模式：仅搜索输入的关键词，不自动扩展。")

    print("筛选模式：标题和简介相关性筛选。")

    try:

        # 建立B站会话
        session.get(
            "https://www.bilibili.com/",
            headers=headers,
            timeout=20
        )

        # 获取WBI密钥
        mixin_key = get_wbi_keys()

        print("B站接口连接成功，开始采集。")

        # 开始采集
        videos, keyword_results = crawl_all_videos(
            keywords,
            target_count,
            mixin_key
        )

        # 导出Excel
        export_to_excel(
            videos,
            keyword_results
        )

    except requests.RequestException as e:

        print(f"\n网络连接失败：{e}")

    except Exception as e:

        print(f"\n程序运行失败：{e}")


if __name__ == "__main__":
    main()
