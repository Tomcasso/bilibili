
import re
import time
import random
import hashlib
import urllib.parse
from pathlib import Path
from datetime import datetime, timezone, timedelta

import requests
import pandas as pd


# ==============================
# 1. 基础配置
# ==============================

BASE_DIR = Path(__file__).resolve().parent

OUTPUT_DIR = BASE_DIR / "output"
OUTPUT_DIR.mkdir(exist_ok=True)

BASE_URL = "https://api.bilibili.com"

# 默认搜索关键词
DEFAULT_KEYWORDS = [
    "岭南饮食文化",
    "粤菜文化",
    "广府菜",
    "客家菜",
    "潮汕美食"
]

# 每个关键词最多采集数量
MAX_RESULTS_LIMIT = 500

# B站每页搜索数量
PAGE_SIZE = 20

# 北京时间
BEIJING_TZ = timezone(timedelta(hours=8))


# ==============================
# 2. 请求配置
# ==============================

session = requests.Session()

headers = {
    "User-Agent": (
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
        "AppleWebKit/537.36 Chrome/131.0.0.0 "
        "Safari/537.36"
    ),
    "Referer": "https://www.bilibili.com/",
    "Accept": "application/json, text/plain, */*"
}


# WBI签名字符映射表
MIXIN_KEY_ENC_TAB = [
    46, 47, 18, 2, 53, 8, 23, 32,
    15, 50, 10, 31, 58, 3, 45, 35,
    27, 43, 5, 49, 33, 9, 42, 19,
    29, 28, 14, 39, 12, 38, 41, 13,
    37, 48, 7, 16, 24, 55, 40, 61,
    26, 17, 0, 1, 60, 51, 30, 4,
    22, 25, 54, 21, 56, 59, 6, 63,
    57, 62, 11, 36, 20, 34, 44, 52
]


# ==============================
# 3. 获取WBI密钥
# ==============================

def get_mixin_key(orig):
    """生成WBI混合密钥"""

    return "".join(
        orig[i] for i in MIXIN_KEY_ENC_TAB
    )[:32]


def get_wbi_keys():
    """获取B站WBI签名密钥"""

    response = session.get(
        BASE_URL + "/x/web-interface/nav",
        headers=headers,
        timeout=20
    )

    response.raise_for_status()

    data = response.json()

    wbi_data = data.get("data", {})
    wbi_img = wbi_data.get("wbi_img", {})

    img_url = wbi_img.get("img_url", "")
    sub_url = wbi_img.get("sub_url", "")

    if not img_url or not sub_url:
        raise RuntimeError(
            f"无法获取WBI密钥：{data}"
        )

    img_key = (
        img_url.rsplit("/", 1)[1].split(".")[0]
    )

    sub_key = (
        sub_url.rsplit("/", 1)[1].split(".")[0]
    )

    return get_mixin_key(
        img_key + sub_key
    )


# ==============================
# 4. WBI参数签名
# ==============================

def sign_params(params, mixin_key):
    """为请求参数生成WBI签名"""

    params = params.copy()

    params["wts"] = int(time.time())

    params = {
        key: re.sub(
            r"[!'()*]",
            "",
            str(value)
        )
        for key, value in params.items()
    }

    query = urllib.parse.urlencode(
        sorted(params.items())
    )

    params["w_rid"] = hashlib.md5(
        (query + mixin_key).encode("utf-8")
    ).hexdigest()

    return params


# ==============================
# 5. 数据格式转换
# ==============================

def clean_text(text):
    """清除标题中的HTML标签"""

    if not text:
        return ""

    import html

    text = html.unescape(str(text))

    text = re.sub(
        r"<[^>]+>",
        "",
        text
    )

    return text.strip()


def format_duration(duration):
    """统一视频时长格式"""

    if not duration:
        return ""

    duration = str(duration).strip()

    parts = duration.split(":")

    try:

        if len(parts) == 2:
            minutes, seconds = map(int, parts)

            return (
                f"{minutes // 60:02d}:"
                f"{minutes % 60:02d}:"
                f"{seconds:02d}"
            )

        elif len(parts) == 3:
            hours, minutes, seconds = map(int, parts)

            return (
                f"{hours:02d}:"
                f"{minutes:02d}:"
                f"{seconds:02d}"
            )

    except ValueError:
        return ""

    return ""


def format_publish_time(timestamp):
    """将Unix时间戳转换为北京时间"""

    if not timestamp:
        return ""

    try:

        dt = datetime.fromtimestamp(
            int(timestamp),
            tz=timezone.utc
        ).astimezone(BEIJING_TZ)

        return dt.strftime(
            "%Y-%m-%d %H:%M:%S"
        )

    except (ValueError, TypeError, OSError):
        return ""


def format_number(number):
    """整理播放量等数字"""

    if number is None:
        return 0

    try:
        return int(number)
    except (ValueError, TypeError):
        return 0


# ==============================
# 6. B站视频搜索（自动分页）
# ==============================


def search_videos(keyword, max_results, mixin_key):
    """搜索视频，持续翻页直到达到指定的有效视频数量"""

    print(f"\n正在搜索：{keyword}")

    videos = []
    collected_ids = set()

    page = 1

    # 连续多少页没有新视频后停止，防止重复翻页
    no_new_pages = 0
    max_no_new_pages = 3

    # 最多尝试100页，避免异常情况下无限请求
    max_pages = 100

    while (
        len(videos) < max_results
        and page <= max_pages
    ):

        # 每页固定请求20条
        params = {
            "search_type": "video",
            "keyword": keyword,
            "page": page,
            "page_size": PAGE_SIZE,
            "order": "totalrank"
        }

        signed_params = sign_params(
            params,
            mixin_key
        )

        try:

            response = session.get(
                BASE_URL + "/x/web-interface/wbi/search/type",
                params=signed_params,
                headers=headers,
                timeout=30
            )

            response.raise_for_status()

            result = response.json()

            if result.get("code") != 0:

                print(
                    f"搜索中断：{keyword}，"
                    f"错误代码：{result.get('code')}，"
                    f"原因：{result.get('message')}"
                )

                break

            data = result.get("data", {})
            items = data.get("result", [])

            # 没有任何搜索结果，说明没有更多数据
            if not items:
                print("没有更多搜索结果。")
                break

            new_count = 0

            for item in items:

                # 提取BV号
                bvid = item.get("bvid", "")

                # 过滤无效视频
                if not bvid or not bvid.startswith("BV"):
                    continue

                # 去重
                if bvid in collected_ids:
                    continue

                collected_ids.add(bvid)

                # 封面
                thumbnail = item.get("pic", "")

                if thumbnail.startswith("//"):
                    thumbnail = "https:" + thumbnail

                video = {
                    "video_id": bvid,

                    "视频标题": clean_text(
                        item.get("title", "")
                    ),

                    "UP主名称": item.get(
                        "author", ""
                    ),

                    "发布时间": format_publish_time(
                        item.get("pubdate", 0)
                    ),

                    "视频时长": format_duration(
                        item.get("duration", "")
                    ),

                    "视频简介": clean_text(
                        item.get(
                            "description",
                            item.get("desc", "")
                        )
                    ),

                    "视频分区": item.get(
                        "typename", ""
                    ),

                    "播放量": format_number(
                        item.get("play", 0)
                    ),

                    "点赞量": format_number(
                        item.get("like", 0)
                    ),

                    "收藏量": format_number(
                        item.get("favorites", 0)
                    ),

                    "检索关键词": keyword,

                    "视频链接": (
                        f"https://www.bilibili.com/video/{bvid}"
                    ),

                    "视频封面": thumbnail
                }

                videos.append(video)
                new_count += 1

                # 达到目标数量，立即停止当前页采集
                if len(videos) >= max_results:
                    break

            # 判断本页是否获取到新的有效视频
            if new_count == 0:
                no_new_pages += 1
            else:
                no_new_pages = 0

            # 连续多页没有新视频，停止
            if no_new_pages >= max_no_new_pages:
                print("连续多页没有新的有效视频，停止搜索。")
                break

            # 达到目标数量，停止翻页
            if len(videos) >= max_results:
                break

            # 下一页
            page += 1

            # 控制请求频率
            time.sleep(
                random.uniform(1.5, 2.5)
            )

        except requests.RequestException as e:

            print(f"网络请求失败：{e}")
            break

        except Exception as e:

            print(f"采集失败：{e}")
            break

    print(
        f"关键词【{keyword}】采集完成，"
        f"有效视频：{len(videos)}/{max_results} 条"
    )

    return videos


# ==============================
# 7. 多关键词采集与去重
# ==============================

def crawl_all_videos(keywords, max_results, mixin_key):
    """多关键词搜索，统一去重"""

    all_videos = {}

    for keyword in keywords:

        videos = search_videos(
            keyword,
            max_results,
            mixin_key
        )

        for video in videos:

            video_id = video["video_id"]

            if video_id in all_videos:

                old_keywords = (
                    all_videos[video_id]["检索关键词"]
                )

                if keyword not in old_keywords.split("；"):

                    all_videos[video_id]["检索关键词"] += (
                        f"；{keyword}"
                    )

            else:

                all_videos[video_id] = video

    return list(all_videos.values())


# ==============================
# 8. Excel导出
# ==============================

def export_to_excel(videos):
    """导出视频采集结果"""

    if not videos:

        print(
            "\n没有采集到有效视频，暂不生成Excel。"
        )

        return

    df = pd.DataFrame(videos)

    # 删除内部使用的视频ID
    df = df.drop(
        columns=["video_id"]
    )

    columns = [
        "视频标题",
        "UP主名称",
        "发布时间",
        "视频时长",
        "视频简介",
        "视频分区",
        "播放量",
        "点赞量",
        "收藏量",
        "检索关键词",
        "视频链接",
        "视频封面"
    ]

    df = df[columns]

    # 生成文件名
    timestamp = datetime.now().strftime(
        "%Y%m%d_%H%M%S"
    )

    file_path = (
        OUTPUT_DIR
        / f"Lingnan_Bilibili_{timestamp}.xlsx"
    )

    # 导出Excel
    df.to_excel(
        file_path,
        index=False
    )

    print("\n" + "=" * 45)
    print("B站视频采集完成！")
    print(f"共采集到：{len(videos)} 个不重复视频")
    print(f"Excel文件已保存至：{file_path}")
    print("=" * 45)


# ==============================
# 9. 主程序
# ==============================

def main():

    print("=" * 50)
    print("       岭南饮食文化 B站视频采集系统")
    print("=" * 50)

    # 输入关键词
    print("\n默认关键词：")
    print("、".join(DEFAULT_KEYWORDS))

    user_input = input(
        "\n请输入搜索关键词"
        "（多个关键词用英文或中文逗号分隔，"
        "直接回车使用默认关键词）："
    ).strip()

    if user_input:

        keywords = [
            word.strip()
            for word in re.split(
                r"[,，]",
                user_input
            )
            if word.strip()
        ]

    else:

        keywords = DEFAULT_KEYWORDS

    # 输入采集数量
    number_input = input(
        "\n请输入每个关键词采集的视频数量"
        "（默认20，最高500）："
    ).strip()

    try:

        max_results = (
            int(number_input)
            if number_input
            else 20
        )

        if not 1 <= max_results <= MAX_RESULTS_LIMIT:
            raise ValueError

    except ValueError:

        print("输入不合法，使用默认数量20。")
        max_results = 20

    print(f"\n搜索关键词数量：{len(keywords)}")
    print(f"每个关键词最多采集：{max_results} 条")

    try:

        # 建立B站会话，获取必要Cookie
        session.get(
            "https://www.bilibili.com/",
            headers=headers,
            timeout=20
        )

        # 获取WBI密钥
        mixin_key = get_wbi_keys()

        print("B站接口连接成功，开始采集。")

        # 多关键词采集
        videos = crawl_all_videos(
            keywords,
            max_results,
            mixin_key
        )

        # Excel导出
        export_to_excel(videos)

    except requests.RequestException as e:

        print(f"\n网络连接失败：{e}")

    except Exception as e:

        print(f"\n程序运行失败：{e}")


if __name__ == "__main__":
    main()
